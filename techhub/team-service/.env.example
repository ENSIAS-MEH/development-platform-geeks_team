# ══════════════════════════════════════════════════════════════════
#  TechHub — Team Service  |  .env.example
#  Owner: Member 3  |  Port: 8084
#
#  HOW TO USE:
#    cp .env.example .env
#    Fill in real values in .env
#    NEVER commit .env — it is in .gitignore
#    This file (.env.example) IS committed — it documents every key
# ══════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────
# Port registry §2.3 — Team Service owns 8084
SERVER_PORT=8083
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL (Member 3 owns PostgreSQL §2.3) ────────────────────
# Internal port: 5432 | External dev port: 5432
# Use 5433 on host if you have a local postgres to avoid conflicts
DB_HOST=localhost
DB_PORT=5432
DB_NAME=team_db
DB_USERNAME=team_user
DB_PASSWORD=CHANGE_ME

# ── Redis (Member 1 owns Redis §2.3) ─────────────────────────────
# Internal port: 6379 | External dev port: 6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka (Member 3 owns Kafka §2.3) ─────────────────────────────
# Internal port: 9092 | External dev port: 9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── JWT ───────────────────────────────────────────────────────────
# MUST match User Service (Member 1) secret exactly
# Generate: openssl rand -hex 32
# Minimum 32 characters / 256 bits
JWT_SECRET=CHANGE_ME_MUST_MATCH_USER_SERVICE_SECRET_MIN_32_CHARS
JWT_EXPIRATION_MS=86400000

# ── HikariCP connection pool ─────────────────────────────────────
HIKARI_MINIMUM_IDLE=5
HIKARI_MAXIMUM_POOL_SIZE=20
HIKARI_IDLE_TIMEOUT_MS=300000
HIKARI_CONNECTION_TIMEOUT_MS=20000
HIKARI_MAX_LIFETIME_MS=1200000

# ── Redis cache TTLs (seconds) ───────────────────────────────────
REDIS_TTL_TEAMS=1800
REDIS_TTL_TEAM_MEMBERS=900
REDIS_TTL_INVITATIONS=300

# ── Invitation settings ──────────────────────────────────────────
INVITATION_EXPIRY_HOURS=48
INVITATION_SCHEDULER_RATE_MS=60000

# ── Team defaults ────────────────────────────────────────────────
TEAM_DEFAULT_MAX_MEMBERS=10

# ── CORS ──────────────────────────────────────────────────────────
# React/Vite frontend (Member 4 owns port 3000 §2.3)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Mail (disabled locally — Notification Service handles emails) ─
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Monitoring (Member 3 owns Prometheus 9090 + Grafana 3001 §2.3)
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
