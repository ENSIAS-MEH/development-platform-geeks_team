# ═══════════════════════════════════════════════════════════════════
#  TechHub — Environment Variables Template
#  Copy to .env and fill in your local values.
#  NEVER commit .env — it is in .gitignore
#  Governance: doc 02 §9
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────
# Shared instance — one container, isolated databases per service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev_only

# ── Team Service DB ───────────────────────────────────────────────
TEAM_DB_NAME=team_db
TEAM_DB_USERNAME=team_user
TEAM_DB_PASSWORD=team_pass_local

# ── Redis ─────────────────────────────────────────────────────────
# Owner: Member 1 (governance §13.1)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── JWT ───────────────────────────────────────────────────────────
# MUST be at least 256 bits (32 chars) — use a secrets manager in prod
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_32_CHAR_SECRET_HERE_LOCAL_ONLY
JWT_EXPIRATION_MS=86400000

# ── Team Service ─────────────────────────────────────────────────
SERVER_PORT=8083
SPRING_PROFILES_ACTIVE=docker

# ── Mail (disabled locally — see application-docker.yml) ─────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Observability ────────────────────────────────────────────────
PROMETHEUS_SCRAPE_INTERVAL=15s
